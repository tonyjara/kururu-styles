{
  "schema": 1,
  "kind": "skin",
  "id": "cobble",
  "name": "Cobble",
  "version": "1.1.0",
  "description": "An inventory screen: grey plates around every pane, slots for tabs, a stone button, experience along the bottom, sand and cobblestone behind. Wear it with Deepslate.",
  "author": "kururu-styles",
  "licence": "CC0-1.0",
  "tokens": {
    "radiusXs": "0",
    "radiusSm": "0",
    "radiusMd": "0",
    "radiusLg": "0",
    "radiusXl": "0",
    "border": "2px",
    "borderThick": "3px",
    "gutter": "4px",
    "uiLetterSpacing": "0.02em",
    "outlineOn": "none",
    "elevDialog": "0 0 0 2px var(--shadow)",
    "elevMenu": "0 0 0 2px var(--shadow)"
  },
  "colors": {
    "chrome": "#c6c6c6",
    "chromeHigh": "#dedede",
    "line": "#555555",
    "lineHigh": "#000000",
    "text": "#3f3f3f",
    "textStrong": "#000000",
    "dim": "#4a4a4a",
    "dimmer": "#7a7a7a",
    "accent": "#5b8731",
    "onAccent": "#ffffff",
    "danger": "#aa0000",
    "dangerBg": "#aa0000",
    "onDanger": "#ffffff",
    "scrim": "rgba(0, 0, 0, 0.5)",
    "shadow": "rgba(0, 0, 0, 0.4)"
  },
  "parts": {
    "sidebar": {
      "image": "sidebar.png",
      "mode": "tile",
      "scale": 3
    },
    "panel": {
      "image": "panel.png",
      "mode": "nine",
      "slice": 3,
      "scale": 2
    },
    "well": {
      "image": "well.png",
      "mode": "tile",
      "scale": 3
    },
    "pane": {
      "image": "pane.png",
      "mode": "nine",
      "slice": 5,
      "scale": 3
    },
    "pane-on": {
      "image": "pane-on.png",
      "mode": "nine",
      "slice": 5,
      "scale": 3
    },
    "tabstrip": {
      "image": "tabstrip.png",
      "mode": "nine",
      "slice": 1,
      "scale": 2,
      "repeat": "repeat"
    },
    "tab": {
      "image": "tab.png",
      "mode": "nine",
      "slice": 2,
      "scale": 2
    },
    "tab-on": {
      "image": "tab-on.png",
      "mode": "nine",
      "slice": 2,
      "scale": 2
    },
    "button": {
      "image": "button.png",
      "mode": "nine",
      "slice": 3,
      "scale": 2
    },
    "row-on": {
      "image": "row-on.png",
      "mode": "nine",
      "slice": 3,
      "scale": 2
    },
    "statusbar": {
      "image": "statusbar.png",
      "mode": "nine",
      "slice": [
        3,
        2,
        1,
        2
      ],
      "scale": 2,
      "repeat": "repeat"
    },
    "dialog": {
      "image": "dialog.png",
      "mode": "nine",
      "slice": 3,
      "scale": 3
    }
  },
  "icons": {
    "close": "x",
    "run": ">",
    "caret": "v",
    "add": "+"
  }
}
