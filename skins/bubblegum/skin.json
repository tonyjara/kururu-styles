{
  "schema": 1,
  "kind": "skin",
  "id": "bubblegum",
  "name": "Bubblegum",
  "version": "1.0.0",
  "description": "Everything rounded off, Nunito, and shadows that behave like light. The friendliest thing you can do to a multiplexer.",
  "author": "kururu-styles",
  "licence": "CC0-1.0",
  "fonts": [
    {
      "family": "Nunito",
      "file": "nunito-variable.woff2",
      "weight": "400 700",
      "style": "normal"
    }
  ],
  "tokens": {
    "radiusXs": "4px",
    "radiusSm": "8px",
    "radiusMd": "10px",
    "radiusLg": "12px",
    "radiusXl": "16px",
    "ui": "\"Nunito\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
    "fsXs": "10px",
    "fsSm": "11px",
    "fsBase": "12px",
    "fsMd": "13px",
    "fsLg": "14px",
    "fsXl": "17px",
    "uiLineHeight": "1.5",
    "frame": "0 2px 12px var(--shadow)",
    "frameOn": "0 0 0 1px var(--line-high), 0 4px 18px var(--shadow)",
    "elevDialog": "0 24px 64px var(--shadow)",
    "elevMenu": "0 16px 40px var(--shadow)",
    "overlay": "radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.05), transparent 60%)",
    "overlayOpacity": "1"
  },
  "icons": {
    "run": "\u25b6",
    "caret": "\u2304"
  }
}
