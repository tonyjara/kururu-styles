{
  "schema": 1,
  "kind": "skin",
  "id": "teletype",
  "name": "Teletype",
  "version": "1.0.0",
  "description": "Square corners, Space Mono everywhere, and a scanline you can just about see. The chrome pretends it is part of the terminal.",
  "author": "kururu-styles",
  "licence": "CC0-1.0",
  "fonts": [
    {
      "family": "Space Mono",
      "file": "space-mono-400.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Space Mono",
      "file": "space-mono-700.woff2",
      "weight": "700",
      "style": "normal"
    }
  ],
  "tokens": {
    "radiusXs": "0",
    "radiusSm": "0",
    "radiusMd": "0",
    "radiusLg": "0",
    "radiusXl": "0",
    "ui": "\"Space Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "fsXs": "9px",
    "fsSm": "10px",
    "fsBase": "11px",
    "fsMd": "11px",
    "fsLg": "12px",
    "fsXl": "14px",
    "uiLineHeight": "1.5",
    "uiLetterSpacing": "0.01em",
    "frame": "inset 0 0 0 1px var(--chrome-high)",
    "frameOn": "inset 0 0 0 1px var(--line-high)",
    "elevDialog": "4px 4px 0 var(--shadow)",
    "elevMenu": "3px 3px 0 var(--shadow)",
    "overlay": "repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px)",
    "overlayOpacity": "0.35"
  },
  "icons": {
    "close": "x",
    "run": ">",
    "caret": "v",
    "add": "+",
    "restart": null,
    "edit": null,
    "external": null
  }
}
