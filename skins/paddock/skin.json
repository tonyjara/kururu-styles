{
  "schema": 1,
  "kind": "skin",
  "id": "paddock",
  "name": "Paddock",
  "version": "1.0.0",
  "description": "Grand Prix in daylight: white garage walls, the same kerb on the pane you are in, the red marker on the selected row and a chequer at each end of the status bar. Wear it with Paddock.",
  "author": "kururu-styles",
  "licence": "CC0-1.0",
  "tokens": {
    "radiusXs": "0",
    "radiusSm": "1px",
    "radiusMd": "2px",
    "radiusLg": "2px",
    "radiusXl": "3px",
    "ui": "\"Avenir Next Condensed\", \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", system-ui, sans-serif",
    "fsXs": "10px",
    "fsSm": "11px",
    "fsBase": "12px",
    "fsMd": "13px",
    "fsLg": "14px",
    "fsXl": "16px",
    "uiLetterSpacing": "0.02em",
    "gutter": "4px",
    "outlineOn": "none"
  },
  "colors": {
    "chrome": "#eeeff1",
    "chromeHigh": "#e1e3e7",
    "line": "#c8cbd1",
    "lineHigh": "#9da2aa",
    "text": "#18191c",
    "textStrong": "#000000",
    "dim": "#4f545c",
    "dimmer": "#6c7179",
    "accent": "#c8101e",
    "onAccent": "#ffffff",
    "danger": "#a80e19",
    "dangerBg": "#c8101e",
    "onDanger": "#ffffff",
    "shadow": "rgba(24, 25, 28, 0.18)"
  },
  "parts": {
    "sidebar": {
      "image": "sidebar.png",
      "mode": "tile",
      "scale": 2
    },
    "panel": {
      "image": "panel.png",
      "mode": "nine",
      "slice": 1,
      "scale": 2
    },
    "well": {
      "image": "well.png",
      "mode": "tile",
      "scale": 2
    },
    "pane": {
      "image": "pane.png",
      "mode": "nine",
      "slice": [
        3,
        2,
        2,
        2
      ],
      "scale": 2,
      "repeat": "repeat"
    },
    "pane-on": {
      "image": "pane-on.png",
      "mode": "nine",
      "slice": [
        3,
        2,
        2,
        2
      ],
      "scale": 2,
      "repeat": "repeat"
    },
    "tabstrip": {
      "image": "tabstrip.png",
      "mode": "nine",
      "slice": [
        1,
        1,
        1,
        1
      ],
      "scale": 2,
      "repeat": "repeat"
    },
    "tab": {
      "image": "tab.png",
      "mode": "nine",
      "slice": 1,
      "scale": 2
    },
    "tab-on": {
      "image": "tab-on.png",
      "mode": "nine",
      "slice": 1,
      "scale": 2
    },
    "button": {
      "image": "button.png",
      "mode": "nine",
      "slice": 1,
      "scale": 2
    },
    "row-on": {
      "image": "row-on.png",
      "mode": "nine",
      "slice": [
        0,
        0,
        0,
        2
      ],
      "scale": 2
    },
    "statusbar": {
      "image": "statusbar.png",
      "mode": "nine",
      "slice": [
        1,
        8,
        1,
        8
      ],
      "scale": 2,
      "repeat": "repeat"
    },
    "dialog": {
      "image": "dialog.png",
      "mode": "nine",
      "slice": [
        2,
        1,
        1,
        1
      ],
      "scale": 2
    }
  }
}
